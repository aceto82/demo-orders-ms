# Copy this file to .env and fill in real values. Never commit .env.

# Application datasources
DB_USERNAME=change-me
DB_PASSWORD=change-me

# api-gateway OAuth2 client
# Generated by Keycloak (README step 4). Re-create the realm and this secret after
# `./dev.sh infra reset`, which discards the Keycloak database.
KEYCLOAK_CLIENT_SECRET=change-me

# Eureka service registry
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change-me

# PostgreSQL (inventory, products, keycloak)
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# MySQL (orders)
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
